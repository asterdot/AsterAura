<Application x:Class="AuraChat.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnMainWindowClose">
    <Application.Resources>
        <SolidColorBrush x:Key="BgBrush" Color="#FFF7F8FA" />
        <SolidColorBrush x:Key="CardBrush" Color="#FFFFFFFF" />
        <SolidColorBrush x:Key="TextBrush" Color="#FF1F2329" />
        <SolidColorBrush x:Key="SubBrush" Color="#FF8A9099" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF3B7DD8" />
    </Application.Resources>
</Application>
