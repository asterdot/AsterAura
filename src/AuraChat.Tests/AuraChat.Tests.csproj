<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.11.1" />
    <PackageReference Include="xunit" Version="2.9.2" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.8.2" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\AuraChat.Core\AuraChat.Core.csproj" />
    <ProjectReference Include="..\AuraChat.Features\AuraChat.Features.csproj" />
    <!-- 路由层的纯函数（DebugRoutes.BuildSystemPartsAsync）要在测试里直调 -->
    <ProjectReference Include="..\AuraChat.Server\AuraChat.Server.csproj" />
    <!-- SecurityBoundaryTests 直接使用 Microsoft.AspNetCore.Http 类型；
         不加此 FrameworkReference 时测试宿主解析不到 ASP.NET Core 共享框架（t4/release-client 2026-11-07） -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

</Project>
